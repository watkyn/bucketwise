%tr{id: dom_id(uncleared), class: uncleared_row_class(uncleared)}
  %td.checkbox= check_box_tag "statement[cleared][]", uncleared.id, uncleared.statement_id, id: dom_id(uncleared, :check), "data-action": "click->statement-reconcile#toggleCleared", "data-item-id": uncleared.id
  %td.date{data: {action: "click->statement-reconcile#clickItem", "item-id": uncleared.id}}= uncleared.occurred_on.strftime("%Y-%m-%d")
  - if uncleared.event.check_number
    %td.check{data: {action: "click->statement-reconcile#clickItem", "item-id": uncleared.id}}= "#" + uncleared.event.check_number.to_s
  %td.actor{data: {action: "click->statement-reconcile#clickItem", "item-id": uncleared.id}}&= uncleared.event.actor_name
  %td.number{data: {action: "click->statement-reconcile#clickItem", "item-id": uncleared.id}}
    %span.hidden{id: dom_id(uncleared, :amount)}= uncleared.amount
    = format_cents(uncleared.amount.abs)
