#data.content{"data-controller": "statement-reconcile"}
  %h2== Let's reconcile your #{h(account.name)} account

  .form

    = form_for([account, statement]) do |form|

      %fieldset

        %p First, take a look at the account statement from your bank or other financial institution.

        %p
          If you haven't reconciled in a while, make sure you start with the
          %em oldest
          statement and work forward.

        %p
          %strong When
          was the statement printed?
          = form.date_field :occurred_on

        %p
          %strong What
          is the ending balance?
          = ("$" + form.text_field(:ending_balance, size: 8, class: "number", value: format_cents(statement.ending_balance, unit: ""), "data-action": "input->statement-reconcile#updateEndingBalance")).html_safe

      %p
        = form.submit "Go to step #2"
        or
        = link_to "cancel", account_path(account)
