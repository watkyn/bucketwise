<div id="data" class="content" data-controller="statement-reconcile">
  <h2><%= "Let's reconcile your #{h(account.name)} account" %></h2>

  <div class="form">

    <%= form_with model: [account, statement] do |form| %>

      <fieldset>

        <p>First, take a look at the account statement from your bank or other financial institution.</p>

        <p>
          If you haven't reconciled in a while, make sure you start with the
          <em>oldest</em>
          statement and work forward.
        </p>

        <p class="flex items-center gap-2 flex-wrap">
          <span>
            <strong>When</strong>
            was the statement printed?
          </span>
          <%= form.date_field :occurred_on %>
        </p>

        <p class="flex items-center gap-2 flex-wrap">
          <span>
            <strong>What</strong>
            is the ending balance?
          </span>
          <%= safe_join([content_tag(:span, "$", class: "mr-1"), form.text_field(:ending_balance, size: 8, class: "number", value: format_cents(statement.ending_balance, unit: ""), "data-action": "input->statement-reconcile#updateEndingBalance focusout->statement-reconcile#formatEndingBalance")]) %>
        </p>

      </fieldset>

      <p>
        <%= form.submit "Go to step #2" %>
        or
        <%= link_to "cancel", account_path(account) %>
      </p>
    <% end %>

  </div>
</div>
