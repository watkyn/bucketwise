<!DOCTYPE html>
<html lang="en">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <%= csrf_meta_tags %>
    <title>BucketWise</title>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "money", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 min-h-screen" data-controller="events-source" data-events-source-location-value="<%= current_location.to_json %>">
    <div id="header" class="bg-bucketwise-green border-b border-bucketwise-green-dark">
      <div class="max-w-3xl mx-auto px-4 py-3 flex items-center justify-between">
        <h1 class="text-2xl font-bold text-bucketwise-green-text">
          <%= link_to "BucketWise", root_path, class: "no-underline text-bucketwise-green-text hover:text-bucketwise-green-dark" %>
        </h1>
        <span class="text-sm">
          <%= link_to "log out", session_path, class: "text-gray-600 hover:text-blue-600", data: { turbo_method: :delete } %>
        </span>
      </div>
    </div>

    <div id="container" class="max-w-3xl mx-auto px-4 py-6">
      <%= yield %>
      <div id="version" class="mt-8 border-t border-gray-200 text-gray-400 text-xs text-right pt-2 leading-relaxed">
        <%= raw("BucketWise version: <span class=\"font-bold\">v#{BucketWise::Version::STRING} (rev <a href=\"https://github.com/jamis/bucketwise/commit/#{application_revision}\" class=\"text-gray-400 font-bold underline\">#{application_revision}</a>)</span>") %>
        <br />
        <%= raw("Last deployed: <span class=\"font-bold\">#{application_last_deployed}</span>") %>
        <br />
        <%= link_to "change password", change_password_url, class: "text-gray-400 font-bold underline hover:text-blue-600" %>
      </div>
    </div>
  </body>
</html>
