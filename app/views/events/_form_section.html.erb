<fieldset id="<%= section %>" class="mb-4 <%= section_visible_for_event?(section) ? "" : "hidden" %>" data-events-form-target="<%= section.to_s.camelize(:lower) %>">
  <legend><%= title %></legend>

  <p class="my-3">
    <%= raw account_prompt %>
    <%= select_account(section, accounts, selected_account && selected_account.id) %>
    <% if section_wants_check_options?(section) %>
      <span id="<%= section %>.check_options" class="<%= check_options_visible_for?(section) ? "" : "hidden" %>">
        <strong>Check #</strong>
        <%= form.text_field :check_number, size: 6 %>
      </span>
    <% end %>
    <% if section_wants_repayment_options?(section) %>
      <span id="<%= section %>.repayment_options" class="repayment_options <%= repayment_options_visible_for?(section) ? "" : "hidden" %>">
        <%= raw "&rarr; " %>
        <%= link_to "Specify repayment options", "#", "data-action": "click->events-form#showRepaymentOptions", "data-section": section %>
      </span>
    <% end %>
  </p>

  <% if section_has_single_bucket?(section) %>
    <p id="<%= section %>.single_bucket" class="my-3">
      <%= raw single_bucket_prompt %>
      <%= select_bucket(section, line_item: line_item_for_section(section)) %>
      <% if section == :credit_options %>
        <br />
        <small>Money from this bucket will be transferred to an "Aside" bucket, to be used later to pay off this credit.</small>
      <% end %>
    </p>
  <% end %>

  <div id="<%= section %>.multiple_buckets" style="<%= multi_bucket_visibility_for(section) %>">
    <p class="my-3">
      <%= raw multi_bucket_prompt %>
      <span id="<%= section %>.unassigned"></span>
    </p>
    <ol id="<%= section %>.line_items" class="my-2 space-y-2">
      <% for_each_line_item_in(section) do |item| %>
        <li><%= render partial: "events/line_item", object: item, locals: { section: section } %></li>
      <% end %>
    </ol>
    <p class="my-3"><%= link_to "More buckets, please!", "#", "data-action": "click->events-form#addLineItem", "data-section": section %></p>
  </div>
</fieldset>
