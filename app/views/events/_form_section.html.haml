%fieldset{id: section, class: section_visible_for_event?(section) ? "" : "hidden", "data-events-form-target": section.to_s.camelize(:lower)}
  %legend= title

  %p
    = account_prompt.html_safe
    = select_account(section, accounts, selected_account && selected_account.id)
    - if section_wants_check_options?(section)
      %span{id: "#{section}.check_options", class: check_options_visible_for?(section) ? "" : "hidden"}
        %strong Check #
        = form.text_field :check_number, size: 6
    - if section_wants_repayment_options?(section)
      %span.repayment_options{id: "#{section}.repayment_options", class: repayment_options_visible_for?(section) ? "" : "hidden"}
        = "&rarr; ".html_safe
        = link_to "Specify repayment options", "#", "data-action": "click->events-form#showRepaymentOptions", "data-section": section

  - if section_has_single_bucket?(section)
    %p{id: "#{section}.single_bucket"}
      = single_bucket_prompt.html_safe
      = select_bucket(section, line_item: line_item_for_section(section))
      - if section == :credit_options
        %br/
        %small Money from this bucket will be transferred to an "Aside" bucket, to be used later to pay off this credit.

  %div{id: "#{section}.multiple_buckets", class: multi_bucket_visibility_for(section)}
    %p
      = multi_bucket_prompt.html_safe
      %span{id: "#{section}.unassigned"}
    %ol{id: "#{section}.line_items"}
      - for_each_line_item_in(section) do |item|
        %li= render partial: "events/line_item", object: item, locals: { section: section }
    %p= link_to "More buckets, please!", "#", "data-action": "click->events-form#addLineItem", "data-section": section
