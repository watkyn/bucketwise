<fieldset id="general_information" class="mb-4" data-events-form-target="generalInfo">
  <legend>General Information</legend>

  <p class="my-3 flex items-center gap-2 flex-wrap">
    <span class="expense_label mr-2">
      <strong>When</strong>
      did this expense occur?
    </span>
    <span class="deposit_label mr-2">
      <strong>When</strong>
      did this deposit occur?
    </span>
    <span class="transfer_label mr-2">
      <strong>When</strong>
      did this transfer occur?
    </span>
    <%= form.date_field :occurred_on %>
  </p>

  <div class="my-3 flex items-center gap-2 flex-wrap">
    <span class="expense_label mr-2">
      <strong>Who</strong>
      received the payment?
    </span>
    <span class="deposit_label mr-2">
      <strong>Where</strong>
      did this deposit come from?
    </span>
    <span class="transfer_label mr-2">
      <strong>What</strong>
      was this transfer for?
    </span>
    <div class="relative inline-block" data-controller="autocomplete" data-autocomplete-items-value="<%= subscription.actors.sort_by(&:sort_name).map(&:name).to_json %>">
      <%= form.text_field :actor_name, size: 30, "data-events-form-target": "actorName", "data-autocomplete-target": "input", "data-action": "input->events-form#checkActorName input->autocomplete#search keydown->autocomplete#navigate" %>
      <ul class="hidden absolute left-0 top-full z-50 bg-white border border-gray-300 rounded shadow-lg max-h-64 overflow-auto w-full" data-autocomplete-target="list"></ul>
    </div>
    <% if form.object.new_record? %>
      <span id="recall_event" class="hidden" data-events-form-target="recallEvent">
        <%= link_to "(recall)", "#", "data-action": "click->events-form#recall", data: { url: subscription_events_path(subscription) } %>
      </span>
    <% end %>
  </div>

  <p class="my-3 flex items-center gap-2 flex-wrap">
    <span class="expense_label mr-2">
      <strong>How much</strong>
      was paid?
    </span>
    <span class="deposit_label mr-2">
      <strong>How much</strong>
      was deposited?
    </span>
    <span class="transfer_label mr-2">
      <strong>How much</strong>
      was transferred?
    </span>
    <%= safe_join([content_tag(:span, "$", class: "mr-1"), text_field_tag(:amount, event_amount_value, size: 8, id: "expense_total", class: "number", "data-events-form-target": "expenseTotal", "data-action": "input->events-form#updateAmount")]) %>
  </p>

</fieldset>
