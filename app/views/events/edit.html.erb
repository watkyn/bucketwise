<div id="data" class="content">
  <h2>Edit transaction</h2>

  <div class="transaction edit form <%= @event.role.to_s %>"
       data-controller="events-form"
       data-events-form-return-to-value="<%= (params[:return_to] || subscription_path(subscription)) %>"
       data-events-form-default-date-value="<%= @event.occurred_on.strftime('%Y-%m-%d').to_json %>"
       data-events-form-default-actor-value="<%= @event.actor_name.to_json %>"
       data-events-form-accounts-value="<%= accounts_with_buckets.to_json %>"
       data-events-form-tags-value="<%= subscription.tags.map(&:name).sort.to_json %>"
       data-events-form-actors-value="<%= subscription.events.distinct.pluck(:actor_name).compact.to_json %>">
    <%= render partial: "events/form" %>
  </div>
</div>
