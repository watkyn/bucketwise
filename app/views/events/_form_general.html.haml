%fieldset#general_information{data: {events_form_target: "generalInfo"}}
  %legend General Information

  %p
    %span.expense_label
      %strong When
      did this expense occur?
    %span.deposit_label
      %strong When
      did this deposit occur?
    %span.transfer_label
      %strong When
      did this transfer occur?
    = form.date_field :occurred_on

  %p
    %span.expense_label
      %strong Who
      received the payment?
    %span.deposit_label
      %strong Where
      did this deposit come from?
    %span.transfer_label
      %strong What
      was this transfer for?
    = form.text_field :actor_name, size: 30, "data-events-form-target": "actorName", "data-action": "input->events-form#checkActorName"
    - if form.object.new_record?
      %span#recall_event.hidden{data: {events_form_target: "recallEvent"}}
        = link_to "(recall)", "#", "data-action": "click->events-form#recall", data: { url: subscription_events_path(subscription) }

  #event_actor_name_select.autocomplete_select.hidden
  %div{"data-controller": "autocomplete", "data-autocomplete-items-value": subscription.actors.sort_by(&:sort_name).map(&:name).to_json}
    %input.hidden{type: "text", "data-autocomplete-target": "input", "data-action": "input->autocomplete#search keydown->autocomplete#navigate"}
    %ul.hidden{"data-autocomplete-target": "list", class: "absolute z-50 bg-white border border-gray-300 rounded shadow-lg max-h-40 overflow-auto w-full"}

  %p
    %span.expense_label
      %strong How much
      was paid?
    %span.deposit_label
      %strong How much
      was deposited?
    %span.transfer_label
      %strong How much
      was transferred?
    = "$#{text_field_tag :amount, event_amount_value, size: 8, id: "expense_total", class: "number", "data-events-form-target": "expenseTotal", "data-action": "input->events-form#updateAmount"}"
