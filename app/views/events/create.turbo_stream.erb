<turbo-stream action="replace" target="recent_entries">
  <template>
    <table id="recent_entries" class="entries">
      <%= render(partial: "events/event", collection: subscription.events.recent.last, formats: [:html]) %>
    </table>
  </template>
</turbo-stream>

<turbo-stream action="replace" target="accounts_summary">
  <template>
    <table id="accounts_summary">
      <%= render(partial: "accounts/account", collection: subscription.accounts, formats: [:html]) %>
    </table>
  </template>
</turbo-stream>

<%# NOTE: the event form lives inside #new_event and already contains a hidden
  #success_notice. Do NOT replace #new_event here — that would destroy the form
  and leave the notice inside a hidden container. The events-form Stimulus
  controller resets the form and reveals the in-form notice client-side
  after rendering these streams. %>
