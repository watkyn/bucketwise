-# Wrap all page content so events-form and accounts-form controllers
-# are ancestors of every data-action on the page.
#subscription{data: {controller: "events-form accounts-form", "events-form-accounts-value": accounts_with_buckets.to_json, "events-form-tags-value": subscription.tags.map(&:name).sort.to_json, "events-form-actors-value": subscription.events.distinct.pluck(:actor_name).compact.to_json, "events-form-return-to-value": subscription_path(subscription), "events-form-default-actor-value": "Bucket reallocation", "events-form-default-date-value": Date.today.to_json}}
  #links.header{class: blank_slate? ? "hidden" : "", data: {events_form_target: "links", accounts_form_target: "links"}}
    %h2
      Record a new
      = link_to "expense", "#", id: "expense_link", "data-action": "click->events-form#revealExpense"
      ,
      = link_to "deposit", "#", id: "deposit_link", "data-action": "click->events-form#revealDeposit"
      , or
      = link_to "transfer", "#", id: "transfer_link", "data-action": "click->events-form#revealTransfer"

  #new_event.transaction.form.hidden{"data-events-form-target": "newEvent"}
    = render partial: "events/form"

  - if blank_slate?
    #blankslate{data: {accounts_form_target: "blankslate"}}
      = render partial: "blank_slate"

  #new_account.form.hidden{data: {accounts_form_target: "form"}}
    = render partial: "accounts/form"

  #data.content{class: blank_slate? ? "hidden" : "", data: {accounts_form_target: "data"}}
    %h2#accounts_summary_header
      %span.actions
        = link_to "Add an account", "#", "data-action": "click->accounts-form#reveal"
      Accounts summary

    %table#accounts_summary= render(subscription.accounts)

    - if subscription.tags.any?
      %h2 Tags
      = render partial: "tags/cloud"

    %h2 Recent transactions
    %table#recent_entries.entries= render(subscription.events.recent.last)
