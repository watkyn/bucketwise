<!DOCTYPE html>
<html lang="en">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Log into BucketWise</title>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-100 min-h-screen flex items-center justify-center px-4">
    <div class="w-full max-w-sm">
      <div class="bg-white rounded-lg shadow-md border border-gray-200 p-6">
        <h1 class="text-xl font-bold text-bucketwise-green-text text-center mb-6">
          <%= link_to "BucketWise", root_path, class: "no-underline text-bucketwise-green-text" %>
        </h1>

        <% if flash[:failed] %>
          <div class="bg-red-50 border border-red-300 text-red-700 rounded px-4 py-3 mb-4 text-sm">
            The user name or password you gave was incorrect. Please try again.
          </div>
        <% end %>
        <% if flash[:logged_out] %>
          <div class="bg-green-50 border border-green-300 text-green-700 rounded px-4 py-3 mb-4 text-sm">
            You have been logged out.
          </div>
        <% end %>

        <%= form_with url: session_path, class: "space-y-4" do %>
          <div>
            <%= label_tag :user_name, "User name", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= text_field_tag :user_name, nil, autofocus: true, class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-bucketwise-green focus:ring-1 focus:ring-bucketwise-green focus:outline-none" %>
          </div>
          <div>
            <%= label_tag :password, "Password", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= password_field_tag :password, nil, class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-bucketwise-green focus:ring-1 focus:ring-bucketwise-green focus:outline-none" %>
          </div>
          <%= submit_tag "Log into BucketWise", class: "w-full bg-bucketwise-green text-bucketwise-green-dark font-bold py-2 px-4 rounded-md hover:bg-bucketwise-green-light transition-colors cursor-pointer border border-bucketwise-green-dark" %>
        <% end %>
      </div>
    </div>
  </body>
</html>
