# Secrets defined here are available for reference under registry/password, env/secret, builder/secrets,
# and accessories/*/env/secret in config/deploy.yml. All secrets should be pulled from either
# password manager, ENV, or a file. DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.

# Server to deploy to (same ENV pattern as mlf-server's CVMLF_IP_ADDRESS).
# Export it before running kamal: `export BUCKETWISE_IP_ADDRESS=1.2.3.4`
BUCKETWISE_IP_ADDRESS=$BUCKETWISE_IP_ADDRESS

# Public hostnames the app is served from (proxy hosts, Rails hosts).
# Comma-separated; the first host is canonical (mailer URLs use it).
BUCKETWISE_HOST=$BUCKETWISE_HOST

# Docker Hub username that owns the container image.
KAMAL_REGISTRY_USERNAME=$KAMAL_REGISTRY_USERNAME

# Grab the registry password from ENV (Docker Hub access token).
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Improve security by using a password manager. Never check config/master.key into git!
RAILS_MASTER_KEY=$(cat config/master.key)
